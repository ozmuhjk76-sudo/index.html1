<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>أسامة شريف محمد أحمد الحداد | بطاقة أعمال رقمية</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        gold: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: radial-gradient(circle at top, #1e293b 0%, #090d16 100%);
            min-height: 100vh;
        }
        .glass-card {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(251, 191, 36, 0.2);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        }
        .service-badge {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .service-badge:hover {
            transform: translateY(-3px);
            background: rgba(251, 191, 36, 0.12);
            border-color: rgba(251, 191, 36, 0.5);
            box-shadow: 0 8px 20px -4px rgba(251, 191, 36, 0.15);
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #fde68a 0%, #f59e0b 50%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .pulse-ring {
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5);
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            70% { box-shadow: 0 0 0 12px rgba(245, 158, 11, 0); }
            100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
        }
    </style>
</head>
<body class="text-white flex items-center justify-center p-4 selection:bg-amber-500 selection:text-black">

    <!-- حاوية البطاقة الرئيسية -->
    <main class="glass-card w-full max-w-md rounded-3xl overflow-hidden relative my-4">
        
        <!-- الغلاف العلوي الزخرفي -->
        <div class="h-32 bg-gradient-to-l from-amber-600/30 via-slate-900 to-amber-500/20 relative overflow-hidden">
            <div class="absolute inset-0 opacity-25 bg-[radial-gradient(#fbbf24_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <!-- زر المشاركة السريعة -->
            <button onclick="shareCard()" title="مشاركة البطاقة" class="absolute top-4 left-4 w-10 h-10 rounded-full bg-slate-900/60 hover:bg-amber-500 hover:text-slate-950 text-amber-400 flex items-center justify-center transition duration-300 border border-amber-500/30">
                <i class="fas fa-share-nodes"></i>
            </button>
        </div>

        <!-- الصورة الرمزية / الشعار -->
        <div class="relative px-6 -mt-16 text-center">
            <div class="w-28 h-28 mx-auto rounded-2xl bg-gradient-to-br from-slate-800 to-slate-950 p-1 border-2 border-amber-400 shadow-xl pulse-ring flex items-center justify-center relative">
                <span class="text-3xl font-extrabold tracking-wider gold-gradient-text">OZM</span>
                <span class="absolute -bottom-1 -right-1 w-5 h-5 bg-emerald-500 border-2 border-slate-900 rounded-full" title="متاح للعمل"></span>
            </div>

            <!-- الاسم والمسمى العام -->
            <h1 class="mt-4 text-xl sm:text-2xl font-extrabold tracking-tight text-white leading-snug">
                أسامة شريف محمد أحمد الحداد
            </h1>
            <p class="mt-1 text-xs sm:text-sm text-amber-400/90 font-semibold">
                الحلول الرقمية المتكاملة • التصميم • البرمجة • التسويق
            </p>
        </div>

        <!-- أزرار التفاعل السريع -->
        <div class="px-6 mt-6 grid grid-cols-2 gap-3">
            <!-- اتصال مباشر -->
            <a href="tel:+967774060647" class="flex items-center justify-center gap-2 bg-gradient-to-l from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold py-3 px-4 rounded-xl shadow-lg shadow-amber-500/20 transition duration-300 active:scale-95">
                <i class="fas fa-phone-flip"></i>
                <span>اتصال مباشر</span>
            </a>
            <!-- واتساب -->
            <a href="https://wa.me/967774060647?text=مرحباً%20أستاذ%20أسامة،%20تواصلت%20معك%20عبر%20بطاقتك%20الرقمية" target="_blank" class="flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-emerald-600/20 transition duration-300 active:scale-95">
                <i class="fab fa-whatsapp text-lg"></i>
                <span>واتساب</span>
            </a>
        </div>

        <!-- عرض الرقم مع خاصية النسخ -->
        <div class="px-6 mt-3">
            <div onclick="copyNumber('774060647')" class="cursor-pointer group bg-slate-800/50 hover:bg-slate-800 border border-slate-700/70 rounded-xl p-3 flex items-center justify-between transition duration-200">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center">
                        <i class="fas fa-mobile-screen-button"></i>
                    </div>
                    <div>
                        <p class="text-[11px] text-slate-400">رقم التواصل المباشر (اضغط للنسخ)</p>
                        <p class="text-sm font-bold tracking-wider text-slate-100 dir-ltr text-right">774 060 647</p>
                    </div>
                </div>
                <span id="copy-status" class="text-xs text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-md group-hover:bg-amber-500 group-hover:text-slate-950 transition">
                    <i class="far fa-copy ml-1"></i>نسخ
                </span>
            </div>
        </div>

        <!-- قسم الخدمات والمهام (تفاعلي: عند الضغط يفتح واتساب بطلب الخدمة) -->
        <div class="px-6 mt-6">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    المهام والخدمات الاحترافية (اضغط لطلب خدمة)
                </h2>
            </div>

            <div class="grid grid-cols-2 gap-2.5 text-right">
                <button onclick="orderService('تصميم مواقع')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-laptop-code text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">تصميم مواقع</span>
                </button>

                <button onclick="orderService('تصميم برامج ويب')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-cubes text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">تصميم برامج ويب</span>
                </button>

                <button onclick="orderService('تصميم هويات بصرية')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-gem text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">تصميم هويات بصرية</span>
                </button>

                <button onclick="orderService('تصميم إعلانات')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-palette text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">تصميم إعلانات</span>
                </button>

                <button onclick="orderService('تسويق إلكتروني')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-bullhorn text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">تسويق إلكتروني</span>
                </button>

                <button onclick="orderService('تسويق ميداني')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-people-arrows text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">تسويق ميداني</span>
                </button>

                <button onclick="orderService('إدارة صفحات تواصل اجتماعي')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-share-alt text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">مدير صفحات تواصل</span>
                </button>

                <button onclick="orderService('كتابة محتوى')" class="service-badge p-3 rounded-xl flex items-center gap-2.5 text-right">
                    <i class="fas fa-pen-nib text-amber-400 text-base w-5 text-center"></i>
                    <span class="text-xs sm:text-sm font-semibold text-slate-200">كاتب محتوى</span>
                </button>
            </div>
        </div>

        <!-- أزرار الحفظ والـ QR Code -->
        <div class="p-6 mt-2 flex gap-2.5">
            <button onclick="downloadVCard()" class="flex-1 bg-slate-100 hover:bg-white text-slate-950 font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition duration-200 shadow-md">
                <i class="fas fa-user-plus"></i>
                <span>حفظ في جهات الاتصال</span>
            </button>
            <button onclick="toggleQRModal()" class="bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 py-3 px-4 rounded-xl flex items-center justify-center transition duration-200" title="عرض رمز QR">
                <i class="fas fa-qrcode text-xl"></i>
            </button>
        </div>

    </main>

    <!-- نافذة رمز الـ QR المنبثقة -->
    <div id="qr-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-slate-900 border border-amber-500/30 rounded-3xl p-6 max-w-xs w-full text-center relative shadow-2xl">
            <button onclick="toggleQRModal()" class="absolute top-4 left-4 text-slate-400 hover:text-white">
                <i class="fas fa-times text-lg"></i>
            </button>
            <h3 class="text-lg font-bold text-amber-400 mb-1">امسح الرمز ضوئياً</h3>
            <p class="text-xs text-slate-400 mb-4">لمشاركة البطاقة أو حفظ الرقم مباشرة</p>
            <div class="bg-white p-4 rounded-2xl inline-block mx-auto">
                <img id="qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://wa.me/967774060647" alt="QR Code" class="w-44 h-44 mx-auto">
            </div>
            <p class="mt-4 text-xs font-semibold text-slate-300">أسامة شريف محمد أحمد الحداد</p>
            <p class="text-xs text-amber-400 font-bold mt-0.5">774060647</p>
        </div>
    </div>

    <script>
        // 1. نسخ الرقم إلى الحافظة
        function copyNumber(num) {
            navigator.clipboard.writeText(num).then(() => {
                const status = document.getElementById('copy-status');
                status.innerHTML = '<i class="fas fa-check ml-1"></i>تم النسخ';
                status.classList.replace('text-amber-400', 'text-emerald-400');
                setTimeout(() => {
                    status.innerHTML = '<i class="far fa-copy ml-1"></i>نسخ';
                    status.classList.replace('text-emerald-400', 'text-amber-400');
                }, 2000);
            });
        }

        // 2. طلب خدمة مباشرة عبر الواتساب عند الضغط على أي مهمة
        function orderService(serviceName) {
            const phone = "967774060647";
            const message = encodeURIComponent(`مرحباً أستاذ أسامة، أود الاستفسار وطلب خدمة: (${serviceName})`);
            window.open(`https://wa.me/${phone}?text=${message}`, '_blank');
        }

        // 3. توليد وتحميل ملف جهة الاتصال (vCard)
        function downloadVCard() {
            const vcardData = [
                "BEGIN:VCARD",
                "VERSION:3.0",
                "FN:أسامة شريف محمد أحمد الحداد",
                "N:الحداد;أسامة;شريف محمد أحمد;;",
                "TITLE:مصمم ومطور ويب وأخصائي تسويق ومحتوى",
                "TEL;TYPE=CELL,VOICE:+967774060647",
                "NOTE:تصميم مواقع - تصميم هويات بصرية - تصميم إعلانات - تصميم برامج ويب - تسويق إلكتروني وميداني - إدارة صفحات تواصل اجتماعي - كتابة محتوى",
                "END:VCARD"
            ].join("\n");

            const blob = new Blob([vcardData], { type: "text/vcard;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url;
            link.download = "Osama_AlHaddad.vcf";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // 4. فتح وإغلاق نافذة الـ QR
        function toggleQRModal() {
            const modal = document.getElementById('qr-modal');
            modal.classList.toggle('hidden');
            modal.classList.toggle('flex');
        }

        // 5. مشاركة البطاقة عبر الهاتف
        function shareCard() {
            if (navigator.share) {
                navigator.share({
                    title: 'أسامة شريف محمد أحمد الحداد - بطاقة أعمال رقمية',
                    text: 'تواصل مع أسامة الحداد لخدمات التصميم، البرمجة، والتسويق الرقمي والميداني: 774060647',
                    url: window.location.href
                });
            } else {
                copyNumber('774060647');
            }
        }
    </script>
</body>
</html>
